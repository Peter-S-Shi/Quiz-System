{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/quiz-studio/schemas/translation-document.schema.json",
  "title": "Quiz Studio Translation Document",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "id",
    "title",
    "folderId",
    "sourceLanguage",
    "targetLanguage",
    "createdAt",
    "updatedAt",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "documentType": { "const": "quiz-studio.translation-document" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "folderId": { "type": "string", "minLength": 1 },
    "sourceLanguage": { "type": "string", "minLength": 1 },
    "targetLanguage": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceText", "position"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceText": { "type": "string", "minLength": 1 },
          "referenceTranslation": { "type": "string" },
          "notes": { "type": "string" },
          "position": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["anonymous", "human", "external-ai", "agent", "system"] },
        "displayLabel": { "type": "string" },
        "toolName": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string" },
        "sourceResponseId": { "type": "string" },
        "sourceReviewId": { "type": "string" },
        "sourceMaterialId": { "type": "string" },
        "createdAt": { "type": "string" },
        "author": { "$ref": "#/$defs/actor" },
        "extensions": { "type": "object" }
      }
    }
  }
}
