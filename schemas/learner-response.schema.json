{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/quiz-studio/schemas/learner-response.schema.json",
  "title": "Quiz Studio Learner Response",
  "type": "object",
  "required": ["schemaVersion", "documentType", "id", "status", "finalizedAt", "material", "session", "responses", "summary"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "documentType": { "const": "quiz-studio.learner-response" },
    "id": { "type": "string", "minLength": 1 },
    "status": { "const": "finalized" },
    "finalizedAt": { "type": "string", "minLength": 1 },
    "material": {
      "type": "object",
      "required": ["type", "id", "title", "snapshot"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "snapshot": {
          "type": "object",
          "required": ["items"],
          "additionalProperties": true,
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "type"],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": ["id", "startedAt", "completedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["itemId", "answer", "result"],
        "additionalProperties": false,
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "answer": {},
          "result": {}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["itemCount", "correctCount", "percent"],
      "additionalProperties": false,
      "properties": {
        "itemCount": { "type": "integer", "minimum": 0 },
        "correctCount": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["anonymous", "human", "external-ai", "agent", "system"] },
        "displayLabel": { "type": "string" },
        "toolName": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string" },
        "sourceResponseId": { "type": "string" },
        "sourceReviewId": { "type": "string" },
        "sourceMaterialId": { "type": "string" },
        "createdAt": { "type": "string" },
        "author": { "$ref": "#/$defs/actor" },
        "extensions": { "type": "object" }
      }
    }
  }
}
